# Diagnostic image: the Modal recipe (docker/modal_deploy.py) on pip Isaac Sim, buildable on a local GPU.
# AssembleBench env on pip Isaac Sim (no NGC login) -- the same recipe as the Modal
# image in docker/modal_deploy.py, buildable on a local GPU host. Use it to separate
# "pip isaacsim 6.0.0.1" from "Modal's gVisor/nvproxy" when something fails on Modal.
#
#   docker build -f docker/Dockerfile.pip -t assemble-bench-pip .
#   docker run --rm --gpus all -p 8766:8765 assemble-bench-pip
FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

ARG ISAACSIM="isaacsim[all,extscache]==6.0.0.1"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common curl ca-certificates git cmake build-essential ffmpeg \
      libglu1-mesa libgl1 libglib2.0-0 libvulkan1 libegl1 libxt6 libgomp1 \
    && add-apt-repository -y ppa:deadsnakes/ppa && apt-get update \
    && apt-get install -y --no-install-recommends python3.12 python3.12-venv python3.12-dev \
    && apt-get purge -y 'mesa-vulkan-drivers*' || true; \
    rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir -U pip && pip install --no-cache-dir "${ISAACSIM}" --extra-index-url https://pypi.nvidia.com

RUN mkdir -p /usr/share/vulkan/icd.d /usr/share/glvnd/egl_vendor.d \
 && echo '{"file_format_version": "1.0.0", "ICD": {"library_path": "libGLX_nvidia.so.0", "api_version": "1.3.0"}}' > /usr/share/vulkan/icd.d/nvidia_icd.json \
 && echo '{"file_format_version": "1.0.0", "ICD": {"library_path": "libEGL_nvidia.so.0"}}' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

ENV OMNI_KIT_ACCEPT_EULA=YES ACCEPT_EULA=Y PRIVACY_CONSENT=Y OMNI_KIT_ALLOW_ROOT=1 \
    NVIDIA_DRIVER_CAPABILITIES=all PYTHONUNBUFFERED=1 \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json __GLX_VENDOR_LIBRARY_NAME=nvidia

COPY . /opt/assemble-bench
RUN bash /opt/assemble-bench/docker/modal_image.sh
WORKDIR /opt/assemble-bench
EXPOSE 8765
CMD ["python", "-m", "hud.environment.server", "env.py", "--host", "0.0.0.0", "--port", "8765"]
